<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="io.github.rejeb.dataform.language.unittest.schema.TestSchemaResolver"
                        serviceImplementation="io.github.rejeb.dataform.language.unittest.schema.TestSchemaResolverImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.unittest.columns.TestColumnAliases"
                        serviceImplementation="io.github.rejeb.dataform.language.unittest.columns.TestColumnAliasesImpl"
        />

        <intentionAction>
            <className>io.github.rejeb.dataform.language.unittest.generation.GenerateTestSelectIntention</className>
            <category>Dataform</category>
        </intentionAction>
        <fileIconProvider implementation="io.github.rejeb.dataform.language.unittest.TestFileIconProvider"/>

        <configurationType
                implementation="io.github.rejeb.dataform.language.unittest.execution.runconfig.DataformTestConfigurationType"/>
        <programRunner
                implementation="io.github.rejeb.dataform.language.unittest.execution.runconfig.DataformTestProgramRunner"/>
        <runConfigurationProducer
                implementation="io.github.rejeb.dataform.language.unittest.execution.runconfig.DataformTestRunConfigurationProducer"/>
        <runLineMarkerContributor
                language="SQLX"
                implementationClass="io.github.rejeb.dataform.language.unittest.execution.runconfig.DataformTestRunLineMarkerContributor"/>
    </extensions>

    <actions>
        <action id="Dataform.CreateTest"
                class="io.github.rejeb.dataform.language.unittest.creation.CreateDataformTestAction"
                text="Create Dataform Test"
                description="Create a unit test for a Dataform table or view"
                icon="io.github.rejeb.dataform.language.DataformIcons.TEST_FILE">
            <add-to-group group-id="ProjectViewPopupMenu"
                          anchor="after"
                          relative-to-action="Dataform.CompareFileWithRemote"/>
            <add-to-group group-id="EditorPopupMenu"
                          anchor="after"
                          relative-to-action="Dataform.CompareFileWithRemote"/>
        </action>
    </actions>
</idea-plugin>
