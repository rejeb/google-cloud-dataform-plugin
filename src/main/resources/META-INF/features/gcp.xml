<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceInterface="io.github.rejeb.dataform.language.gcp.auth.DataformAuthState"
                serviceImplementation="io.github.rejeb.dataform.language.gcp.auth.DataformAuthStateImpl"/>
        <applicationService
                serviceInterface="io.github.rejeb.dataform.language.gcp.auth.DataformCredentialsService"
                serviceImplementation="io.github.rejeb.dataform.language.gcp.auth.DataformCredentialsServiceImpl"/>
        <editorNotificationProvider
                implementation="io.github.rejeb.dataform.language.gcp.auth.DataformAuthEditorNotificationProvider"/>

        <projectService
                serviceInterface="io.github.rejeb.dataform.language.gcp.settings.GcpRepositorySettings"
                serviceImplementation="io.github.rejeb.dataform.language.gcp.settings.GcpRepositorySettingsImpl"/>
        <projectService
                serviceInterface="io.github.rejeb.dataform.language.gcp.service.DataformGcpFileCache"
                serviceImplementation="io.github.rejeb.dataform.language.gcp.service.DataformGcpFileCacheImpl"/>
        <projectService
                serviceInterface="io.github.rejeb.dataform.language.gcp.service.DataformGcpService"
                serviceImplementation="io.github.rejeb.dataform.language.gcp.service.DataformGcpServiceImpl"/>

        <toolWindow
                id="Dataform Tools"
                anchor="right"
                factoryClass="io.github.rejeb.dataform.language.gcp.toolwindow.DataformGcpToolWindowFactory"
                icon="/icons/toolWindowDataform.svg"/>

        <applicationService serviceInterface="io.github.rejeb.dataform.language.gcp.clone.PendingRepositoryLinks"
                            serviceImplementation="io.github.rejeb.dataform.language.gcp.clone.PendingRepositoryLinksImpl"/>
        <postStartupActivity
                order="first"
                implementation="io.github.rejeb.dataform.language.gcp.clone.DataformRepositoryLinkActivity"/>
    </extensions>

    <actions>
        <action id="Dataform.CompareFileWithRemote"
                class="io.github.rejeb.dataform.language.gcp.action.CompareFileWithRemoteAction"
                text="Compare File with Remote"
                description="Compare the local file with its remote GCP Dataform version">
            <add-to-group group-id="CompareActions" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu"
                          anchor="before"
                          relative-to-action="CompareFileWithEditor"/>
            <add-to-group group-id="EditorPopupMenu"
                          anchor="before"
                          relative-to-action="CompareClipboardWithSelection"/>
        </action>
    </actions>
</idea-plugin>
