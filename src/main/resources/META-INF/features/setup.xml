<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="io.github.rejeb.dataform.language.setup.DataformInterpreterManager"
                        serviceImplementation="io.github.rejeb.dataform.language.setup.DataformInterpreterManagerImpl"
                        testServiceImplementation="io.github.rejeb.dataform.language.setup.DataformInterpreterManagerTestImpl"
        />
        <applicationService serviceInterface="io.github.rejeb.dataform.language.setup.DataformCoreVersionProvider"
                            serviceImplementation="io.github.rejeb.dataform.language.setup.NpmRegistryDataformCoreVersionProvider"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.setup.DataformPackageInstaller"
                        serviceImplementation="io.github.rejeb.dataform.language.setup.DataformPackageInstallerImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.setup.DataformCoreVersionMigrator"
                        serviceImplementation="io.github.rejeb.dataform.language.setup.DataformCoreVersionMigratorImpl"
        />

        <postStartupActivity
                order="first"
                implementation="io.github.rejeb.dataform.language.setup.DataformInstaller"/>
        <postStartupActivity
                implementation="io.github.rejeb.dataform.language.startup.DataformProjectStartup"/>
        <postStartupActivity
                implementation="io.github.rejeb.dataform.language.setup.DataformCoreVersionMigrationActivity"/>
        <postStartupActivity
                implementation="io.github.rejeb.dataform.language.setup.DataformPendingPackageInstallActivity"/>

        <facetType implementation="io.github.rejeb.dataform.language.projectWizard.DataformFacetType"/>
        <framework.detector implementation="io.github.rejeb.dataform.language.projectWizard.DataformFrameworkDetector"/>
        <directoryProjectGenerator
                implementation="io.github.rejeb.dataform.language.projectWizard.DataformDirectoryProjectGenerator"/>
        <moduleBuilder builderClass="io.github.rejeb.dataform.language.projectWizard.DataformModuleBuilder"/>

        <applicationService
                serviceInterface="io.github.rejeb.dataform.language.settings.DataformToolsSettings"
                serviceImplementation="io.github.rejeb.dataform.language.settings.DataformToolsSettingsImpl"/>
        <applicationConfigurable
                parentId="tools"
                instance="io.github.rejeb.dataform.language.settings.DataformToolsConfigurable"
                id="io.github.rejeb.dataform.language.settings.DataformToolsConfigurable"
                displayName="Dataform"/>
    </extensions>
</idea-plugin>
