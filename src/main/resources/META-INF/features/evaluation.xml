<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceInterface="io.github.rejeb.dataform.language.evaluation.DataformExpressionEvaluationService"
                serviceImplementation="io.github.rejeb.dataform.language.evaluation.DataformExpressionEvaluationServiceImpl"
        />

        <lang.foldingBuilder
                language="SQLX"
                implementationClass="io.github.rejeb.dataform.language.folding.SqlxTemplateFoldingBuilder"/>
        <lang.foldingBuilder
                language="JavaScript"
                implementationClass="io.github.rejeb.dataform.language.folding.DataformJsFoldingBuilder"/>
        <editorFactoryListener
                implementation="io.github.rejeb.dataform.language.folding.DataformValueFoldClickListener"/>

        <vfs.asyncListener
                implementation="io.github.rejeb.dataform.language.evaluation.DataformEvaluationInvalidator"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.rejeb.dataform.language.evaluation.DataformEvaluationFocusListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="io.github.rejeb.dataform.language.evaluation.DataformEvaluationFocusListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
        <listener class="io.github.rejeb.dataform.language.evaluation.DataformEvaluationFocusListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
</idea-plugin>
