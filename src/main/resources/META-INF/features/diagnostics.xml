<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="io.github.rejeb.dataform.language.validation.DataformEditActivityService"
                        serviceImplementation="io.github.rejeb.dataform.language.validation.DataformEditActivityServiceImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.validation.SqlxValidationService"
                        serviceImplementation="io.github.rejeb.dataform.language.validation.SqlxValidationServiceImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.diagnostics.sql.bigquery.BigQueryDiagnosticsService"
                        serviceImplementation="io.github.rejeb.dataform.language.diagnostics.sql.bigquery.BigQueryDiagnosticsServiceImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.diagnostics.compile.CompilationProblemsService"
                        serviceImplementation="io.github.rejeb.dataform.language.diagnostics.compile.CompilationProblemsServiceImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.diagnostics.ValidationProblemInlayManager"
                        serviceImplementation="io.github.rejeb.dataform.language.diagnostics.ValidationProblemInlayManagerImpl"
        />

        <annotator
                language="SQLX"
                implementationClass="io.github.rejeb.dataform.language.validation.DataformValidationAnnotator"/>
        <annotator
                language="JavaScript"
                implementationClass="io.github.rejeb.dataform.language.validation.DataformValidationAnnotator"/>

        <localInspection
                language="JavaScript"
                shortName="DataformPartitionByObject"
                displayName="Dataform partitionBy written as an object"
                groupName="Dataform"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.rejeb.dataform.language.config.inspection.PartitionByObjectInspection"/>

        <editorNotificationProvider
                implementation="io.github.rejeb.dataform.language.diagnostics.UnlocatedErrorsNotificationProvider"/>
        <editorFactoryListener
                implementation="io.github.rejeb.dataform.language.diagnostics.ValidationProblemInlayEditorListener"/>
        <vfs.asyncListener
                implementation="io.github.rejeb.dataform.language.diagnostics.DiagnosticsRefreshListener"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.rejeb.dataform.language.diagnostics.sql.bigquery.BigQueryDiagnosticsRefresher"
                  topic="io.github.rejeb.dataform.language.schema.sql.DataformSchemaEvent"/>
        <listener class="io.github.rejeb.dataform.language.diagnostics.CompilationDiagnosticsRefresher"
                  topic="io.github.rejeb.dataform.language.compilation.DataformCompilationEvent"/>
    </projectListeners>
</idea-plugin>
