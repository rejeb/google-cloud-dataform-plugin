<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="io.github.rejeb.dataform.language.lineage.service.LineageGraphService"
                        serviceImplementation="io.github.rejeb.dataform.language.lineage.service.LineageGraphServiceImpl"
        />
        <projectService serviceInterface="io.github.rejeb.dataform.language.lineage.dataplex.DataplexLineageService"
                        serviceImplementation="io.github.rejeb.dataform.language.lineage.dataplex.DataplexLineageServiceImpl"/>
        <projectService serviceInterface="io.github.rejeb.dataform.language.lineage.dataplex.cache.DataplexLineageCache"
                        serviceImplementation="io.github.rejeb.dataform.language.lineage.dataplex.cache.DataplexLineageCacheImpl"/>
        <projectService serviceInterface="io.github.rejeb.dataform.language.lineage.dataplex.OutsideTableColumns"
                        serviceImplementation="io.github.rejeb.dataform.language.lineage.dataplex.OutsideTableColumnsImpl"/>

        <toolWindow
                id="Dataform Lineage"
                anchor="bottom"
                canCloseContents="false"
                doNotActivateOnStart="true"
                factoryClass="io.github.rejeb.dataform.language.lineage.toolwindow.LineageToolWindowFactory"
                icon="/icons/lineage.svg"/>
        <projectService
                serviceInterface="io.github.rejeb.dataform.language.lineage.toolwindow.LineageToolWindow"
                serviceImplementation="io.github.rejeb.dataform.language.lineage.toolwindow.LineageToolWindowImpl"/>

        <fileEditorProvider implementation="io.github.rejeb.dataform.language.lineage.view.LineageFileEditorProvider"/>
        <fileIconProvider implementation="io.github.rejeb.dataform.language.lineage.view.LineageFileIconProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="io.github.rejeb.dataform.language.lineage.view.LineageTabCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <action id="Dataform.OpenLineageView"
                class="io.github.rejeb.dataform.language.lineage.view.OpenLineageViewAction"
                text="Open Dataform Lineage"
                description="Open the project-wide Dataform table and column lineage view"
                icon="io.github.rejeb.dataform.language.DataformIcons.LINEAGE">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="SearchEverywhere"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift D"/>
        </action>
    </actions>
</idea-plugin>
