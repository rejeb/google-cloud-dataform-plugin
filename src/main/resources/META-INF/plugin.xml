    <projectListeners>
        <listener class="io.github.rejeb.dataform.language.diagnostics.sql.bigquery.BigQueryDiagnosticsRefresher"
                  topic="io.github.rejeb.dataform.language.schema.sql.DataformSchemaEvent"/>
        <listener class="io.github.rejeb.dataform.language.diagnostics.CompilationDiagnosticsRefresher"
                  topic="io.github.rejeb.dataform.language.compilation.DataformCompilationEvent"/>
        <listener class="io.github.rejeb.dataform.language.evaluation.DataformEvaluationFocusListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="io.github.rejeb.dataform.language.evaluation.DataformEvaluationFocusListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
        <listener class="io.github.rejeb.dataform.language.compilation.DataformCompileOnSaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
        <listener class="io.github.rejeb.dataform.language.lineage.view.LineageTabCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <action id="GotoDeclaration"
                class="io.github.rejeb.dataform.language.schema.sql.usages.SqlxColumnNavigationAction"
                overrides="true"/>
        <action id="Dataform.ShowColumnUsages"
                class="io.github.rejeb.dataform.language.schema.sql.ShowDataformColumnUsagesAction"
                text="Show Column Usages"
                description="Show where the Dataform column under the caret is declared and read">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift U"/>
        </action>
        <action id="Dataform.DiagnoseColumnResolution"
                class="io.github.rejeb.dataform.language.schema.sql.diagnostics.DiagnoseColumnResolutionAction"
                text="Diagnose Dataform Column Resolution"
                description="Report step by step how the Dataform column under the caret is resolved">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Dataform.ShowColumnUsages"/>
        </action>
        <action id="Dataform.CompareFileWithRemote"
                class="io.github.rejeb.dataform.language.gcp.action.CompareFileWithRemoteAction"
                text="Compare File with Remote"
                description="Compare the local file with its remote GCP Dataform version">
            <add-to-group group-id="CompareActions" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu"
                          anchor="before"
                          relative-to-action="CompareFileWithEditor"/>
            <add-to-group group-id="EditorPopupMenu"
                          anchor="before"
                          relative-to-action="CompareClipboardWithSelection"/>
        </action>
        <action id="Dataform.CreateTest"
                class="io.github.rejeb.dataform.language.unittest.creation.CreateDataformTestAction"
                text="Create Dataform Test"
                description="Create a unit test for a Dataform table or view">
            <add-to-group group-id="ProjectViewPopupMenu"
                          anchor="after"
                          relative-to-action="Dataform.CompareFileWithRemote"/>
            <add-to-group group-id="EditorPopupMenu"
                          anchor="after"
                          relative-to-action="Dataform.CompareFileWithRemote"/>
        </action>
        <action id="Dataform.OpenLineageView"
                class="io.github.rejeb.dataform.language.lineage.view.OpenLineageViewAction"
                text="Open Dataform Lineage"
                description="Open the project-wide Dataform table and column lineage view"
                icon="io.github.rejeb.dataform.language.DataformIcons.LINEAGE">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="SearchEverywhere"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift D"/>
        </action>
        <action id="Dataform.NewSqlxFile"
                class="io.github.rejeb.dataform.language.action.CreateSqlxFileAction"
                text="SQLX File"
                description="Create a new Dataform SQLX file"
                icon="io.github.rejeb.dataform.language.DataformIcons.FILE">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
