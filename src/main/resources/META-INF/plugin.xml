<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>io.github.rejeb.gcp-dataform-plugin</id>

    <name>Google Cloud Dataform</name>

    <vendor url="https://github.com/rejeb/google-cloud-dataform-plugin">rbenrejeb</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>NodeJS</depends>
    <depends>com.intellij.modules.sql</depends>
    <depends>com.intellij.database</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="dataform-buildview.xml">com.intellij.modules.buildView</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="dataform-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <notificationGroup id="Dataform.Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"
        />
    </extensions>

    <xi:include href="/META-INF/features/language.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/setup.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/gcp.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/schema.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/evaluation.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/diagnostics.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/compilation.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/completion.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/navigation.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/documentation.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/columns.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/preview.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/lineage.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/query-execution.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/workflow-run.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/features/unittest.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
